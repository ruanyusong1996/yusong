{
  "name": "gh-dashboard",
  "version": "1.1.0",
  "description": "海底捞集团工会工作数据看板（前端 + 后端 + SSE 实时同步）",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node test-persistence.js all && node run-auth-test-local.js && node run-e2e-local.js",
    "test:persist": "node test-persistence.js all",
    "test:api": "node run-auth-test-local.js",
    "test:e2e": "node run-e2e-local.js",
    "test:e2e:nonpersist": "E2E_NONPERSIST=1 E2E_DATA_DIR=./.nonpersist-test-data E2E_PORT=5333 node run-e2e-local.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3"
  },
  "engines": {
    "node": ">=18"
  }
}
